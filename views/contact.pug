h2 
  | #{contact.name} 
  span(
    hx-get=`/contacts/${contact.id}/count`,
    hx-trigger='every 2s',
    hx-swap='innerHTML'
  ) #{contact.count || 0}
  
p #[strong Name:] #{contact.name}
p #[strong Email:] #{contact.email}

img(
  src='images/image_1.png',
  alt=`Avatar of ${contact.name}`,
  width='100',
  height='100'
)

div.actions
  form(method='POST', action=`/delete/${contact.id}?_method=DELETE`)
    button(
      type='submit',
      hx-delete=`/delete/${contact.id}`,
      hx-target='#sidebar',
      hx-push-url='/contacts'
      class='link'
    ) Delete Contact

  a(
    href=`/contacts/${contact.id}/edit`,
    hx-get=`/contacts/${contact.id}/edit`,
    hx-push-url='true',
    hx-target='#content'
  ) Edit Contact